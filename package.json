{
  "name": "leonida-tracker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Personal, ad-free GTA 6 map tracker (PWA)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "tiles": "node scripts/tiles.mjs",
    "dev-data": "node scripts/dev-data.mjs",
    "test": "vitest run",
    "icons": "node scripts/icons.mjs"
  },
  "dependencies": {
    "@material-symbols/svg-400": "^0.49.0",
    "dexie": "^4.4.7",
    "leaflet": "^1.9.4",
